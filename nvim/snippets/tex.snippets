snippet assigment "Assigment Template"
  \documentclass[11pt]{exam}
  \newcommand{\myname}{Name}
  \newcommand{\myhwtype}{Assignment n}
  \newcommand{\myclass}{Class}

  \newcommand{\questiontype}{Question}

  \newcommand{\writtensection}{0}

  \usepackage{amsmath, amsfonts, amsthm, amssymb}
  \usepackage{enumitem}
  \usepackage{graphicx}
  \usepackage[T1]{fontenc}
  \usepackage{caption}
  \usepackage{float}
  \usepackage{framed}

  \usepackage{centernot}
  \usepackage{mathtools}
  \usepackage{pgfplots}
  \usepackage{pgf-pie}
  \usepackage{hyperref} % load hyperref last

  \pgfplotsset{compat=1.18}
  \usepgfplotslibrary{statistics}
  \DeclarePairedDelimiter{\ceil}{\lceil}{\rceil}
  \DeclarePairedDelimiter{\floor}{\lfloor}{\rfloor}
  \DeclarePairedDelimiter{\card}{\vert}{\vert}

  \setlength{\parindent}{0pt}
  \setlength{\parskip}{5pt plus 1pt}

  \def\indented{\list{}{}\item[]}
  \let\endindented=\endlist

  \newcounter{questionCounter}
  \newcounter{partCounter}[questionCounter]

  \newenvironment{namedquestion}[1][\arabic{questionCounter}]{%
      \addtocounter{questionCounter}{1}%
      \setcounter{partCounter}{0}%
      \vspace{.2in}%
      \noindent{\bf #1}%
      \vspace{0.3em} \hrule \vspace{.1in}%
  }{}

  \newenvironment{numedquestion}{%
      \stepcounter{questionCounter}%
      \vspace{.2in}%
      \ifx\writtensection\undefined
          \noindent{\bf \questiontype \; \arabic{questionCounter}. }%
      \else
          \if\writtensection0
              \noindent{\bf \questiontype \; \arabic{questionCounter}. }%
          \else
              \noindent{\bf \questiontype \; \writtensection.\arabic{questionCounter} }%
          \fi
      \fi
      \vspace{0.3em} \hrule \vspace{.1in}%
  }{}

  \newenvironment{alphaparts}{%
    \begin{enumerate}[label=\textbf{(\alph*)}]
  }{\end{enumerate}}

  \newenvironment{arabicparts}{%
    \begin{enumerate}[label=\textbf{\arabic{questionCounter}.\arabic*)}]
  }{\end{enumerate}}

  \newenvironment{questionpart}{%
    \item
  }{}

  \newcommand{\answerbox}[1]{%
  \begin{framed}
  \vspace{#1}
  \end{framed}}

  \pagestyle{head}
  \headrule
  \extraheadheight{0.5in}
  \header{\textbf{\myclass}\\ \textbf{\myname}\\ \textbf{\myhwtype}}{}{}

  \begin{document}
      % Remove the next line if you want the header on page 1 as well
      \thispagestyle{plain}

      \begin{center}
        {\Large \myclass{} \myhwtype{}} \\
        \myname{} \\
        \today
      \end{center}

      \begin{numedquestion}
      \end{numedquestion}
  \end{document}
